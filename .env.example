# DATABASE URL (Supabase / Postgres URL)
# Example: postgresql://postgres.xxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# OPENAI API KEY (For generating articles and tweets)
# Example: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=""

# NEXTAUTH SECRETS (For Admin Dashboard Login)
# Run `npx auth secret` to generate a random string
AUTH_SECRET=""

# ADMIN CREDENTIALS (For single-tenant auth)
ADMIN_EMAIL="admin@nexus.com"
ADMIN_PASSWORD_HASH="" # bcrypt hash of your admin password

# VERCEL CRON SECRET
# Example: a-secure-random-string
CRON_SECRET=""

# FRONTEND URL
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# GOOGLE ADSENSE (Revenue Dashboard)
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_CLIENT_SECRET=

# ALERT WEBHOOK (System Health Notifications)
# Paste a Slack / Discord webhook URL here
ALERT_WEBHOOK_URL=

# GOOGLE INDEXING API (Fast URL indexing)
GOOGLE_INDEXING_API_KEY=
