# ============================================================
# NEXUS MEDIA EMPIRE — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Get from: https://supabase.com → Project → Settings → Database
DATABASE_URL=

# ── AI Engine (NVIDIA NIM or OpenAI) ────────────────────────
# Get NVIDIA key (zero limits): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI Fallback: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Monthly budget cap in USD (default: $20)
MAX_MONTHLY_AI_BUDGET=20

# ── Auth (Admin Login) ──────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=
ADMIN_EMAIL=admin@nexus.com
# bcrypt hash of your password. Generate with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── Cron Security ───────────────────────────────────────────
CRON_SECRET=change-this-to-a-random-string

# ── Google AdSense ──────────────────────────────────────────
# Your AdSense publisher ID (e.g. pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT=pub-0000000000000000

# ── Google APIs (optional — for real revenue data) ──────────
# Set up at: https://console.cloud.google.com
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_CLIENT_SECRET=
GOOGLE_INDEXING_API_KEY=

# ── Telegram Bot ────────────────────────────────────────────
# See TELEGRAM_SETUP.md for full instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=

# ── Alerting ────────────────────────────────────────────────
# Optional: send health check failures to a webhook (Slack, Discord, Make.com etc.)
ALERT_WEBHOOK_URL=

# ── Frontend URLs ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3002
