generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String?
  site            String    @default("news") // "news", "crypto", "finance"
  category        String
  excerpt         String
  content         String
  metaTitle       String?
  metaDescription String?
  imagePrompt     String?
  image           String?
  featured        Boolean   @default(false)
  status          String    @default("draft") // "draft", "scheduled", "published", "rejected"
  qaStatus        String?   @default("pending") // "pending", "approved", "revision_needed", "rejected"
  qaVerdict       Json?
  source          String?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  publishAt       DateTime?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

model PipelineStepState {
  id                  String    @id @default(cuid())
  step                String    @unique // "trend_scout", "qa_review", "publisher"
  status              String    @default("active") // "active", "paused", "failed"
  lastRun             DateTime?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model QALog {
  id                   String   @id @default(cuid())
  articleId            String
  factualSoundness     Float?
  originality          Float?
  readability          Float?
  seoStructure         Float?
  averageScore         Float
  verdict              String   // "APPROVE", "REVISE", "REJECT"
  rejectionReason      String?
  revisionInstructions String?
  model                String   @default("gpt-4o-mini")
  reviewedAt           DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  niche        String   @default("general")
  status       String   @default("active")
  subscribedAt DateTime @default(now())
}

model TokenUsage {
  id            String   @id @default(cuid())
  month         String   @unique // "YYYY-MM"
  tokensUsed    Int      @default(0)
  estimatedCost Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model SitemapQueue {
  id        String   @id @default(cuid())
  url       String   @unique
  status    String   @default("pending") // "pending", "indexed", "failed"
  createdAt DateTime @default(now())
}

model AdSlot {
  id                  String   @id @default(cuid())
  name                String
  siteTargeting       String   // "all", "news", "crypto", "finance"
  placement           String   // "header", "inArticle", "midFeed", "sidebar", "footer"
  type                String   // "adsense", "affiliate", "direct", "house"
  adCode              String?  // HTML/JS code for adsense/direct
  headline            String?  // For affiliate/house
  description         String?  
  ctaUrl              String?  // For affiliate/house
  weight              Int      @default(1)
  isActive            Boolean  @default(true)
  requiresDisclosure  Boolean  @default(true)
  frequencyCapPerUser Int      @default(0) // 0 means unlimited
  priority            Int      @default(1)
  updatedAt           DateTime @updatedAt
}

model ClickLog {
  id        String   @id @default(cuid())
  slug      String
  targetUrl String
  site      String?
  device    String?
  timestamp DateTime @default(now())
}

model AlertLog {
  id        String   @id @default(cuid())
  type      String   // 'site_down', 'revenue_drop', 'article_zero', 'ads_txt_fail'
  message   String
  severity  String   // 'info', 'warning', 'critical'
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnalyticsCache {
  id            String   @id @default(cuid())
  site          String
  todayRevenue  Float    @default(0)
  weekRevenue   Float    @default(0)
  monthRevenue  Float    @default(0)
  pageviews     Int      @default(0)
  rpm           Float    @default(0)
  ctr           Float    @default(0)
  syncedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
