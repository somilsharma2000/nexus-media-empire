{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/pipeline/trend-scout", "schedule": "0 8 * * *" },
    { "path": "/api/pipeline/publish", "schedule": "0 9 * * *" },
    { "path": "/api/monitor/cron", "schedule": "0 12 * * *" },
    { "path": "/api/content-doctor", "schedule": "0 3 * * 1" },
    { "path": "/api/report/weekly", "schedule": "0 9 * * 0" }
  ]
}
